{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "strict": true,
    "noEmitOnError": true,
    "verbatimModuleSyntax": true,
    "rootDir": "frontend",
    "outDir": "public/js",
    "skipLibCheck": true
  },
  "include": ["frontend/**/*.ts"]
}
