    "AgeRule": {
      "additionalProperties": false,
      "description": "One exact age rule, including gender/category conditions.",
      "properties": {
        "category": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Category"
        },
        "gender": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Gender"
        },
        "min_age": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ],
          "title": "Min Age"
        },
        "max_age": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ],
          "title": "Max Age"
        },
        "relaxation_years": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ],
          "title": "Relaxation Years"
        },
        "conditions": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Conditions"
        }
      },
      "required": [
        "category",
        "gender",
        "min_age",
        "max_age",
        "relaxation_years",
        "conditions"
      ],
      "title": "AgeRule",
      "type": "object"
    },
    "BundleFacts": {
      "additionalProperties": false,
      "properties": {
        "posts": {
          "items": {
            "$ref": "#/$defs/CandidatePost"
          },
          "title": "Posts",
          "type": "array",
          "minItems": 1
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/FieldEvidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "missing_fields": {
