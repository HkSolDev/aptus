        "fee_payment_last_date",
        "exam_dates",
        "nationality_requirement",
        "locations",
        "employment_type",
        "vacancy_breakdown",
        "experience_rules",
        "fee_rules",
        "pay",
        "selection_process",
        "application_steps",
        "documents_required",
        "language_requirements",
        "other_requirements",
        "official_site_url",
        "apply_url"
