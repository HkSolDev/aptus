        "evidence",
        "missing_fields"
      ],
      "title": "BundleFacts",
      "type": "object"
    },
    "CandidatePost": {
      "additionalProperties": false,
      "description": "Trial extraction fields; not a change to the database ingestion contract.",
      "properties": {
        "post_name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "vacancies": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ],
          "title": "Vacancies"
        },
        "application_last_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            {
              "type": "null"
            }
          ],
          "description": "Format YYYY-MM-DD. Indian sources write DD/MM/YYYY (day first). null if not stated or unclear.",
          "title": "Application Last Date"
        },
        "age_as_on_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            {
              "type": "null"
            }
          ],
          "description": "Format YYYY-MM-DD. Indian sources write DD/MM/YYYY (day first). null if not stated or unclear.",
          "title": "Age As On Date"
        },
        "min_age": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ],
          "title": "Min Age"
        },
        "max_age": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ],
          "title": "Max Age"
        },
        "education_required": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Education Required"
        },
        "post_group": {
          "anyOf": [
            {
              "enum": [
                "A",
                "B",
                "C",
                "D"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Post Group"
        },
        "pay_level": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Pay Level"
