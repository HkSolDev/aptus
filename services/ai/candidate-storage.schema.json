        "min_education_level": {
          "anyOf": [
            {
              "enum": [
                "TENTH",
                "TWELFTH",
                "DIPLOMA",
                "BACHELORS",
                "MASTERS",
                "PHD"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Min Education Level"
