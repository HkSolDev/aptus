# Disabled until you configure Google locally. Never paste credentials into chat.
AUTH_ENABLED=false
# Passkeys require localhost (not 127.0.0.1); use this exact origin in the browser.
# Google redirect URI: http://localhost:8080/api/auth/callback/google
BETTER_AUTH_URL=http://localhost:8080
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Manual/cron extraction launcher; choose a free-tier project in AI Studio.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash
# A comma-separated list is supported; GEMINI_API_KEY_1, _2, etc. also work.
# Rotate only on explicitly rejected keys, never quota/timeouts.
GEMINI_API_KEY=
# Alternative: set LLM_PROVIDER=deepseek and LLM_MODEL=deepseek-flash.
DEEPSEEK_API_KEY=
# With DeepSeek: defer peak-hour startup and requests, with a five-minute margin.
# Production cron launches --once at 04:00, 10:00, 16:00 and 22:00 IST.
DEEPSEEK_OFF_PEAK_ONLY=true

# Optional: Next.js jobs-cache revalidation endpoint, notified after publication commits
FRONTEND_REVALIDATE_URL=
