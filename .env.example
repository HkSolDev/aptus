# Disabled until you configure Google locally. Never paste credentials into chat.
AUTH_ENABLED=false
# Passkeys require localhost (not 127.0.0.1); use this exact origin in the browser.
# Google redirect URI: http://localhost:8080/api/auth/callback/google
BETTER_AUTH_URL=http://localhost:8080
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Manual/cron extraction launcher; choose a free-tier project in AI Studio.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
