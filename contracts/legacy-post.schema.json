        "category",
        "gender",
        "min_age",
        "max_age",
        "relaxation_years",
        "conditions"
      ],
      "title": "AgeRule",
      "type": "object"
    },
    "CategoryRelaxationRules": {
      "additionalProperties": false,
      "properties": {
        "SC": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Sc"
        },
        "ST": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "St"
        },
        "OBC": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Obc"
        },
        "EWS": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ews"
        },
        "PwBD": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Pwbd"
        }
      },
      "required": ["SC", "ST", "OBC", "EWS", "PwBD"],
      "title": "CategoryRelaxationRules",
      "type": "object"
    },
    "EducationOption": {
      "additionalProperties": false,
      "description": "One alternative route through which a candidate can qualify.",
      "properties": {
        "minimum_level": {
          "anyOf": [
            {
              "enum": [
                "TENTH",
                "TWELFTH",
                "DIPLOMA",
                "BACHELORS",
                "MASTERS",
                "PHD"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Minimum Level"
        },
        "minimum_marks_percent": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Minimum Marks Percent"
        },
        "qualification": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Qualification"
        },
        "subject_requirement": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Subject Requirement"
        },
        "conditions": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Conditions"
        }
      },
      "required": [
        "minimum_level",
        "minimum_marks_percent",
        "qualification",
        "subject_requirement",
        "conditions"
      ],
      "title": "EducationOption",
      "type": "object"
    },
    "EligibilityRules": {
      "additionalProperties": false,
      "description": "Detailed rules kept when a flat Post field is not expressive enough.",
      "properties": {
        "gender_requirement": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Gender Requirement"
        },
        "category_requirement": {
          "items": {
            "type": "string"
          },
          "title": "Category Requirement",
          "type": "array"
        },
        "education_options": {
          "items": {
            "$ref": "#/$defs/EducationOption"
          },
          "title": "Education Options",
          "type": "array"
        },
        "age_rules": {
          "items": {
            "$ref": "#/$defs/AgeRule"
          },
          "title": "Age Rules",
          "type": "array"
        },
        "relaxation_combination_rule": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Relaxation Combination Rule"
        }
      },
      "required": [
        "gender_requirement",
        "category_requirement",
        "education_options",
        "age_rules",
        "relaxation_combination_rule"
      ],
      "title": "EligibilityRules",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "post_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Post Name"
    },
    "recruiting_body": {
      "anyOf": [
        {
          "maxLength": 200,
          "type": "string"
        },
        {
          "type": "null"
        }
