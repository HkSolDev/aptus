      "title": "Application Last Date"
    },
    "age_as_on_date": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "Format YYYY-MM-DD. Indian sources write DD/MM/YYYY (day first). null if not stated or unclear.",
      "title": "Age As On Date"
    },
    "min_age": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Min Age"
    },
    "max_age": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Max Age"
    },
    "education_required": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Education Required"
    },
    "post_group": {
      "anyOf": [
        {
          "enum": ["A", "B", "C", "D"],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Post Group"
    },
    "pay_level": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Pay Level"
    },
    "min_education_level": {
      "anyOf": [
        {
          "enum": [
            "TENTH",
            "TWELFTH",
            "DIPLOMA",
            "BACHELORS",
            "MASTERS",
            "PHD"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Min Education Level"
    },
    "min_marks_percent": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Min Marks Percent"
    },
    "category_relaxation_applies": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "title": "Category Relaxation Applies"
    },
    "category_relaxation_rules": {
      "anyOf": [
        {
          "$ref": "#/$defs/CategoryRelaxationRules"
        },
        {
          "type": "null"
        }
      ]
    },
    "eligibility_rules": {
      "$ref": "#/$defs/EligibilityRules"
    }
