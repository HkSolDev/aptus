    "recruiting_body",
    "vacancies",
    "application_last_date",
    "age_as_on_date",
    "min_age",
    "max_age",
    "education_required",
    "post_group",
    "pay_level",
    "min_education_level",
    "min_marks_percent",
    "category_relaxation_applies",
    "category_relaxation_rules",
    "eligibility_rules"
  ],
  "title": "Post",
  "type": "object",
  "$id": "https://aptus.invalid/contracts/legacy-post.schema.json",
