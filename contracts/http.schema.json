{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aptus.invalid/contracts/http-v1",
  "title": "Aptus observed HTTP boundary shapes v1",
  "description": "Read docs/contracts/README.md for scope, semantic invariants and known nonconformance. Not installed as runtime middleware.",
  "definitions": {
    "Education": {
      "type": "object",
      "properties": {
        "level": {
          "enum": ["TENTH", "TWELFTH", "DIPLOMA", "BACHELORS", "MASTERS", "PHD"]
        },
        "marksPercent": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 100
        }
      },
      "required": ["level", "marksPercent"],
      "additionalProperties": false
    },
    "Profile": {
      "type": "object",
      "properties": {
        "dob": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "category": {
          "enum": [null, "General", "OBC", "SC", "ST", "EWS", "PwBD"]
        },
        "educations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/Education"
          }
        }
      },
      "required": ["dob", "category", "educations"],
      "additionalProperties": false
    },
    "ProfileInput": {
      "type": "object",
      "properties": {
        "dob": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "category": {
          "enum": [null, "General", "OBC", "SC", "ST", "EWS", "PwBD"]
        },
        "educations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "level": {
                "enum": [
                  "TENTH",
                  "TWELFTH",
                  "DIPLOMA",
                  "BACHELORS",
                  "MASTERS",
                  "PHD"
                ]
              },
              "marksPercent": {
                "type": ["number", "null"],
                "minimum": 0,
                "maximum": 100
              }
            },
            "required": ["level"],
            "additionalProperties": false
          }
        }
      },
      "required": ["dob", "educations"],
      "additionalProperties": false
    },
    "ProfileResponse": {
      "type": "object",
      "properties": {
        "profile": {
          "anyOf": [
            {
              "$ref": "#/definitions/Profile"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["profile"],
      "additionalProperties": true
    },
    "Source": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "notificationPdfUrl": {
          "type": ["string", "null"]
        },
        "officialSiteUrl": {
          "type": ["string", "null"]
        },
        "applyUrl": {
          "type": ["string", "null"]
        },
        "fetchedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "name",
        "url",
        "notificationPdfUrl",
        "officialSiteUrl",
        "applyUrl",
        "fetchedAt"
      ],
      "additionalProperties": true
    },
    "PublicJob": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "postName": {
          "type": "string"
        },
        "organization": {
          "type": ["string", "null"]
        },
        "postGroup": {
          "enum": ["A", "B", "C", "D", null]
        },
        "payLevel": {
          "type": ["string", "null"]
        },
        "vacancies": {
          "type": ["integer", "null"]
        },
        "applicationLastDate": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "ageAsOnDate": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "minAge": {
          "type": ["integer", "null"]
        },
        "maxAge": {
          "type": ["integer", "null"]
        },
        "educationRequired": {
          "type": ["string", "null"]
        },
        "minEducationLevel": {
          "enum": [
            "TENTH",
            "TWELFTH",
            "DIPLOMA",
            "BACHELORS",
            "MASTERS",
            "PHD",
            null
          ]
        },
        "minMarksPercent": {
          "type": ["number", "null"]
        },
        "source": {
          "$ref": "#/definitions/Source"
        }
      },
      "required": [
        "id",
        "postName",
        "organization",
        "postGroup",
        "payLevel",
        "vacancies",
        "applicationLastDate",
        "ageAsOnDate",
        "minAge",
        "maxAge",
        "educationRequired",
        "minEducationLevel",
        "minMarksPercent",
        "source"
      ],
      "additionalProperties": true
    },
    "JobDetail": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "postName": {
          "type": "string"
        },
        "organization": {
          "type": ["string", "null"]
        },
        "postGroup": {
          "enum": ["A", "B", "C", "D", null]
        },
        "payLevel": {
          "type": ["string", "null"]
        },
        "vacancies": {
          "type": ["integer", "null"]
        },
        "applicationLastDate": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "ageAsOnDate": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "minAge": {
          "type": ["integer", "null"]
        },
        "maxAge": {
          "type": ["integer", "null"]
        },
        "educationRequired": {
          "type": ["string", "null"]
        },
        "minEducationLevel": {
          "enum": [
            "TENTH",
            "TWELFTH",
            "DIPLOMA",
            "BACHELORS",
            "MASTERS",
            "PHD",
            null
          ]
        },
        "minMarksPercent": {
          "type": ["number", "null"]
        },
        "source": {
          "$ref": "#/definitions/Source"
        },
        "reviewedDetails": {
          "type": ["object", "null"]
        },
        "eligibilityRules": {
          "type": ["object", "null"]
        },
        "categoryRelaxationApplies": {
          "type": ["boolean", "null"]
        },
        "categoryRelaxationRules": {
          "type": ["object", "null"]
        }
      },
      "required": [
        "id",
        "postName",
        "organization",
        "postGroup",
        "payLevel",
        "vacancies",
        "applicationLastDate",
        "ageAsOnDate",
        "minAge",
        "maxAge",
        "educationRequired",
        "minEducationLevel",
        "minMarksPercent",
        "source",
        "reviewedDetails",
        "eligibilityRules",
        "categoryRelaxationApplies",
        "categoryRelaxationRules"
      ],
      "additionalProperties": true
    },
    "Pagination": {
      "type": "object",
      "properties": {
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "pageSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "totalItems": {
          "type": "integer",
          "minimum": 0
        },
        "totalPages": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": ["page", "pageSize", "totalItems", "totalPages"],
      "additionalProperties": true
    },
    "JobsResponse": {
      "type": "object",
      "properties": {
        "data": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/PublicJob"
          }
        },
        "pagination": {
          "$ref": "#/definitions/Pagination"
        }
      },
      "required": ["data", "pagination"],
      "additionalProperties": true
    },
    "SavedJob": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "postName": {
          "type": "string"
        },
        "organization": {
          "type": ["string", "null"]
        },
        "postGroup": {
          "enum": ["A", "B", "C", "D", null]
        },
        "payLevel": {
          "type": ["string", "null"]
        },
        "vacancies": {
          "type": ["integer", "null"]
        },
        "applicationLastDate": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "ageAsOnDate": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "minAge": {
          "type": ["integer", "null"]
        },
        "maxAge": {
          "type": ["integer", "null"]
        },
        "educationRequired": {
          "type": ["string", "null"]
        },
        "minEducationLevel": {
          "enum": [
            "TENTH",
            "TWELFTH",
            "DIPLOMA",
            "BACHELORS",
            "MASTERS",
            "PHD",
            null
          ]
        },
        "minMarksPercent": {
          "type": ["number", "null"]
        },
        "source": {
          "$ref": "#/definitions/Source"
        },
        "savedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "postName",
        "organization",
        "postGroup",
        "payLevel",
        "vacancies",
        "applicationLastDate",
        "ageAsOnDate",
        "minAge",
        "maxAge",
        "educationRequired",
        "minEducationLevel",
        "minMarksPercent",
        "source",
        "savedAt"
      ],
      "additionalProperties": true
    },
    "SavedJobsResponse": {
      "type": "object",
      "properties": {
        "data": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SavedJob"
          }
        },
        "pagination": {
          "$ref": "#/definitions/Pagination"
        }
      },
      "required": ["data", "pagination"],
      "additionalProperties": true
    },
    "SavedStatus": {
      "type": "object",
      "properties": {
        "savedIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["savedIds"],
      "additionalProperties": true
    },
    "SaveResponse": {
      "type": "object",
      "properties": {
        "saved": {
          "const": true
        },
        "savedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["saved", "savedAt"],
      "additionalProperties": true
    },
    "UnsaveResponse": {
      "type": "object",
      "properties": {
        "saved": {
          "const": false
        }
      },
      "required": ["saved"],
      "additionalProperties": true
    },
    "MatchItem": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "postName": {
          "type": "string"
        },
        "sourceName": {
          "type": "string"
        },
        "sourceUrl": {
          "type": "string"
        },
        "payLevel": {
          "type": ["string", "null"]
        },
        "ageComparison": {
          "type": "string"
        },
        "categoryRelaxationApplied": {
          "type": ["string", "null"]
        }
      },
      "required": [
        "id",
        "postName",
        "sourceName",
        "sourceUrl",
        "payLevel",
        "ageComparison",
        "categoryRelaxationApplied"
      ],
      "additionalProperties": true
    },
    "ManualItem": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "postName": {
          "type": "string"
        },
        "sourceName": {
          "type": "string"
        },
        "sourceUrl": {
          "type": "string"
        },
        "payLevel": {
          "type": ["string", "null"]
        },
        "reason": {
          "type": "string"
        },
        "educationRequired": {
          "type": ["string", "null"]
        }
      },
      "required": [
        "id",
        "postName",
        "sourceName",
        "sourceUrl",
        "payLevel",
        "reason",
        "educationRequired"
      ],
      "additionalProperties": true
    },
    "MatchResponse": {
      "type": "object",
      "properties": {
        "userId": {
          "type": "string"
        },
        "matches": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/MatchItem"
          }
        },
        "needsManualCheck": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ManualItem"
          }
        },
        "sourcesChecked": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["userId", "matches", "needsManualCheck", "sourcesChecked"],
      "additionalProperties": true
    },
    "ExplainResponse": {
      "type": "object",
      "properties": {
        "explanation": {
          "type": "string"
        }
      },
      "required": ["explanation"],
      "additionalProperties": true
    },
    "Error": {
      "type": "object",
      "properties": {
        "error": {
          "type": "string"
        }
      },
      "required": ["error"],
      "additionalProperties": true
    },
    "PublicationReceipt": {
      "type": "object",
      "properties": {
        "candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "draft_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "post_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": ["candidate_id", "content_hash", "draft_sha256", "post_ids"],
      "additionalProperties": true
    },
    "Approval": {
      "type": "object",
      "properties": {
        "draft_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "reviewed_by": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1500
        },
        "bundle_id": {
          "type": "string"
        },
        "approved_at": {
          "type": "string"
        }
      },
      "required": ["draft_sha256", "reviewed_by", "note", "bundle_id"],
      "additionalProperties": true
    },
    "ReviewedRequest": {
      "type": "object",
      "properties": {
        "reviewed_candidate_json": {
          "type": "string",
          "description": "Exact UTF-8 draft bytes represented as a JSON string; backend also enforces <=1000000 bytes."
        },
        "approval": {
          "$ref": "#/definitions/Approval"
        }
      },
      "required": ["reviewed_candidate_json", "approval"],
      "additionalProperties": true
    },
    "LegacyRequest": {
      "type": "object",
      "required": ["source_url", "source_name", "posts"],
      "properties": {
        "source_url": {
          "type": "string"
        },
        "source_name": {
          "type": "string"
        },
        "raw_hash": {
          "type": ["string", "null"]
        },
        "notification_pdf_url": {
          "type": ["string", "null"]
        },
        "official_site_url": {
          "type": ["string", "null"]
        },
        "apply_url": {
          "type": ["string", "null"]
        },
        "source_text": {
          "type": "string"
        },
        "posts": {
          "type": "array",
          "items": {
            "$ref": "legacy-post.schema.json"
          }
        }
      },
      "additionalProperties": true,
      "description": "Current Python producer envelope; legacy API runtime accepts a wider set. See worker-backend gap WB-LEGACY-VALIDATION."
    },
    "LegacyReceipt": {
      "type": "object",
      "required": ["sourceId", "created", "skipped"],
      "properties": {
        "sourceId": {
          "type": "string"
        },
        "created": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "skippedAsUnchanged": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    }
  }
}
