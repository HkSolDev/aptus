{
  "name": "aptus",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "start": "pnpm serve",
    "serve": "pnpm build:web && tsx --env-file=.env src/server.ts",
    "build:web": "tsc -p tsconfig.web.json",
    "dev:web": "tsc -p tsconfig.web.json --watch",
    "test:web": "pnpm build:web && pnpm next:build && node --import ./tests/css-module-hook.mjs --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "next:dev": "next dev -p 8080",
    "next:build": "next build",
    "next:start": "next start -p 8080",
    "day1": "tsx --env-file=.env scripts/day1-fetch-ssc-pdf.ts",
    "extract": "tsx --env-file=.env scripts/extract.ts",
    "match": "tsx --env-file=.env scripts/match.ts",
    "lint": "eslint .",
    "test:review": "node --import tsx --test scripts/review-workflow.test.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "node --import ./tests/css-module-hook.mjs --import tsx --test scripts/**/*.test.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.28.2",
  "dependencies": {
    "@better-auth/passkey": "1.7.7",
    "@better-auth/prisma-adapter": "1.7.7",
    "@better-auth/utils": "0.4.2",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@prisma/client-runtime-utils": "7.10.0",
    "@types/node": "^26.4.1",
    "better-auth": "1.7.7",
    "cheerio": "^1.2.0",
    "dotenv": "^17.4.2",
    "fastify": "5.12.5",
    "@types/pdf-parse": "^1.1.5",
    "next": "16.4.0",
    "openai": "^7.10.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.0",
    "playwright": "^1.63.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "tsx": "^4.23.13"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "eslint": "^10.10.0",
    "prettier": "^3.9.6",
    "prisma": "7.10.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0"
  }
}
