// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String      @id @default(cuid())
  name       String?
  dob        DateTime
  category   String
  createdAt  DateTime    @default(now())
  educations Education[]
}

// One row per level completed, since job posts require marks at a
// SPECIFIC level (e.g. "60% in 10th" vs "55% in Bachelor's") — a single
// "highest level" field on User would lose the percentage at lower levels.
model Education {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id])
  level          EducationLevel
  marksPercent   Float?

  @@unique([userId, level])
}

model Source {
  id         String   @id @default(cuid())
  name       String
  url        String
  rawHash    String?
  fetchedAt  DateTime @updatedAt

  posts Post[]
}

enum EducationLevel {
  TENTH
  TWELFTH
  DIPLOMA
  BACHELORS
  MASTERS
  PHD
}

enum PostGroup {
  A
  B
  C
  D
}

model Post {
  id                         String          @id @default(cuid())
  sourceId                   String
  source                     Source          @relation(fields: [sourceId], references: [id])
  postName                   String
  postGroup                  PostGroup?
  payLevel                   String?
  minAge                     Int?
  maxAge                     Int?
  vacancies                  Int?
  applicationLastDate        DateTime?
  ageAsOnDate                DateTime?
  // Raw text kept for display + manual verification when the level below
  // can't be classified confidently (e.g. subject-specific requirements).
  educationRequired          String?
  minEducationLevel          EducationLevel?
  minMarksPercent            Float?
  categoryRelaxationApplies  Boolean?
  // Age relaxation in years per category for THIS post specifically,
  // e.g. { "SC": 5, "OBC": 3 }. Kept per-post, not on Source, because a
  // notification can grant different relaxation to different post groups
  // (e.g. SSC CGL gives Group 'C' posts additional relaxation beyond the
  // general table) — one shared value would be wrong for some posts.
  categoryRelaxationRules    Json?
}
