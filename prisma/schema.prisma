// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Login identity is separate from eligibility details.
model AuthUser {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  profile       User?
  sessions      AuthSession[]
  accounts      AuthAccount[]
  passkeys      AuthPasskey[]
  savedJobs     SavedJob[]
}

// Public verification material only; private keys stay with the authenticator.
model AuthPasskey {
  id           String   @id @default(cuid())
  userId       String
  user         AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String?
  publicKey    String
  credentialID String   @unique
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime @default(now())
  aaguid       String?

  @@index([userId])
}

// Aptus login sessions, not Google's access tokens.
model AuthSession {
  id        String   @id @default(cuid())
  userId    String
  user      AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?

  @@index([userId])
  @@index([expiresAt])
}

// A verified provider identity linked to an Aptus account.
model AuthAccount {
  id                    String   @id @default(cuid())
  userId                String
  user                  AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerId            String
  accountId             String
  // Library-compatible optional fields; never return or log their contents.
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

// Short-lived library verification records; expiry is checked by auth code.
model AuthVerification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@index([expiresAt])
}

// Historical name: User is the applicant profile, not the login account.
model User {
  id         String      @id @default(cuid())
  name       String?
  dob        DateTime
  category   String
  createdAt  DateTime    @default(now())
  educations Education[]
  // Existing profiles stay unclaimed. Never infer this link from submitted IDs.
  authUserId String?     @unique
  authUser   AuthUser?   @relation(fields: [authUserId], references: [id], onDelete: Restrict)
}

// One row per level completed, since job posts require marks at a
// SPECIFIC level (e.g. "60% in 10th" vs "55% in Bachelor's") — a single
// "highest level" field on User would lose the percentage at lower levels.
model Education {
  id           String         @id @default(cuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id])
  level        EducationLevel
  marksPercent Float?

  @@unique([userId, level])
}

model Source {
  id                 String   @id @default(cuid())
  name               String
  url                String   @unique
  rawHash            String?
  fetchedAt          DateTime @updatedAt
  // Shared by every post on this notification page (e.g. one Railway RRB
  // NTPC page lists 4 posts, all pointing at the same PDF/apply/official
  // links) — found by code from the page's labeled table rows, never by
  // the LLM, since an invented URL would send a user to the wrong place.
  notificationPdfUrl String?
  officialSiteUrl    String?
  applyUrl           String?

  posts Post[]
}

enum EducationLevel {
  TENTH
  TWELFTH
  DIPLOMA
  BACHELORS
  MASTERS
  PHD
}

enum PostGroup {
  A
  B
  C
  D
}

model Post {
  id                        String          @id @default(cuid())
  sourceId                  String
  source                    Source          @relation(fields: [sourceId], references: [id])
  postName                  String
  organization              String?
  postGroup                 PostGroup?
  payLevel                  String?
  minAge                    Int?
  maxAge                    Int?
  vacancies                 Int?
  applicationLastDate       DateTime?
  ageAsOnDate               DateTime?
  // Raw text kept for display + manual verification when the level below
  // can't be classified confidently (e.g. subject-specific requirements).
  educationRequired         String?
  minEducationLevel         EducationLevel?
  minMarksPercent           Float?
  categoryRelaxationApplies Boolean?
  // Age relaxation in years per category for THIS post specifically,
  // e.g. { "SC": 5, "OBC": 3 }. Kept per-post, not on Source, because a
  // notification can grant different relaxation to different post groups
  // (e.g. SSC CGL gives Group 'C' posts additional relaxation beyond the
  // general table) — one shared value would be wrong for some posts.
  categoryRelaxationRules   Json?
  eligibilityRules          Json?
  extractionCandidateId     String?
  candidatePostIndex        Int?
  extractionCandidate       ExtractionCandidate? @relation(fields: [extractionCandidateId], references: [id], onDelete: Restrict)
  reviewedDetails           Json?
  reviewedAt                DateTime?
  reviewNote                String?
  // First publication of this post in Aptus. Set only on creation in the
  // publication paths; never overwritten on update. Null means the row
  // predates this field and its first-publication time is unknown.
  publishedAt               DateTime?
  savedBy                   SavedJob[]

  @@unique([extractionCandidateId, candidatePostIndex])
  @@index([publishedAt])
}

// Account-owned saved jobs shortlist, independent of profile completion.
model SavedJob {
  id         String   @id @default(cuid())
  authUserId String
  authUser   AuthUser @relation(fields: [authUserId], references: [id], onDelete: Cascade)
  postId     String
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  savedAt    DateTime @default(now())

  @@unique([authUserId, postId])
  @@index([authUserId, savedAt])
}

// Offline extraction drafts. Public browsing and matching read Post, not this table.
model ExtractionCandidate {
  id            String   @id @default(cuid())
  bundleId      String
  sourceUrl     String
  sourceName    String
  contentHash   String   @unique
  status        String   @default("needs_review")
  facts         Json
  review        Json
  evidenceUnits Json
  createdAt     DateTime @default(now())
  publishedPosts Post[]

  @@index([bundleId, createdAt])
}

// Private held-candidate review workflow: items, immutable human revisions, and validation tasks.
model ReviewItem {
  id                String           @id @default(cuid())
  bundleId          String           @unique
  sourceUrl         String
  sourceName        String
  status            String           @default("held")
  holdReason        String?
  currentRevisionId String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  revisions         ReviewRevision[]
  currentRevision   ReviewRevision?  @relation("CurrentRevision", fields: [currentRevisionId], references: [id], onDelete: SetNull)

  @@index([status, updatedAt])
}

model ReviewRevision {
  id               String           @id @default(cuid())
  reviewItemId     String
  reviewItem       ReviewItem       @relation(fields: [reviewItemId], references: [id], onDelete: Cascade)
  revisionNumber   Int
  parentRevisionId String?
  parentRevision   ReviewRevision?  @relation("RevisionHierarchy", fields: [parentRevisionId], references: [id], onDelete: SetNull)
  childRevisions   ReviewRevision[] @relation("RevisionHierarchy")

  facts            Json
  sourceEvidence   Json
  evidenceUnits    Json
  rawDigest        String?
  canonicalHash    String
  changeReason     String?
  createdBy        String           @default("worker_import")
  createdAt        DateTime         @default(now())
  validationState  String           @default("none")

  isCurrentFor     ReviewItem[]     @relation("CurrentRevision")
  validationTasks  ValidationTask[]

  @@unique([reviewItemId, revisionNumber])
  @@index([canonicalHash])
}

model ValidationTask {
  id               String         @id @default(cuid())
  reviewRevisionId String
  reviewRevision   ReviewRevision @relation(fields: [reviewRevisionId], references: [id], onDelete: Cascade)
  status           String         @default("pending")
  validatorVersion String         @default("aptus-val-v1")
  claimToken       String?
  claimExpiresAt   DateTime?
  result           Json?
  errorDetails     String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([status, claimExpiresAt])
  @@index([reviewRevisionId, validatorVersion])
}
