// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Login identity is separate from eligibility details.
model AuthUser {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  profile       User?
  sessions      AuthSession[]
  accounts      AuthAccount[]
  passkeys      AuthPasskey[]
}

// Public verification material only; private keys stay with the authenticator.
model AuthPasskey {
  id           String   @id @default(cuid())
  userId       String
  user         AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String?
  publicKey    String
  credentialID String   @unique
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime @default(now())
  aaguid       String?

  @@index([userId])
}

// Aptus login sessions, not Google's access tokens.
model AuthSession {
  id        String   @id @default(cuid())
  userId    String
  user      AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?

  @@index([userId])
  @@index([expiresAt])
}

// A verified provider identity linked to an Aptus account.
model AuthAccount {
  id                    String   @id @default(cuid())
  userId                String
  user                  AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerId            String
  accountId             String
  // Library-compatible optional fields; never return or log their contents.
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

// Short-lived library verification records; expiry is checked by auth code.
model AuthVerification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@index([expiresAt])
}

// Historical name: User is the applicant profile, not the login account.
model User {
  id         String      @id @default(cuid())
  name       String?
  dob        DateTime
  category   String
  createdAt  DateTime    @default(now())
  educations Education[]
  // Existing profiles stay unclaimed. Never infer this link from submitted IDs.
  authUserId String?     @unique
  authUser   AuthUser?   @relation(fields: [authUserId], references: [id], onDelete: Restrict)
}

// One row per level completed, since job posts require marks at a
// SPECIFIC level (e.g. "60% in 10th" vs "55% in Bachelor's") — a single
// "highest level" field on User would lose the percentage at lower levels.
model Education {
  id           String         @id @default(cuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id])
  level        EducationLevel
  marksPercent Float?

  @@unique([userId, level])
}

model Source {
  id                 String   @id @default(cuid())
  name               String
  url                String   @unique
  rawHash            String?
  fetchedAt          DateTime @updatedAt
  // Shared by every post on this notification page (e.g. one Railway RRB
  // NTPC page lists 4 posts, all pointing at the same PDF/apply/official
  // links) — found by code from the page's labeled table rows, never by
  // the LLM, since an invented URL would send a user to the wrong place.
  notificationPdfUrl String?
  officialSiteUrl    String?
  applyUrl           String?

  posts             Post[]
  automationRecords AutomatedNoticeRecord[]
}

enum EducationLevel {
  TENTH
  TWELFTH
  DIPLOMA
  BACHELORS
  MASTERS
  PHD
}

enum PostGroup {
  A
  B
  C
  D
}

model Post {
  id                        String          @id @default(cuid())
  sourceId                  String
  source                    Source          @relation(fields: [sourceId], references: [id])
  postName                  String
  organization              String?
  postGroup                 PostGroup?
  payLevel                  String?
  minAge                    Int?
  maxAge                    Int?
  vacancies                 Int?
  applicationLastDate       DateTime?
  ageAsOnDate               DateTime?
  // Raw text kept for display + manual verification when the level below
  // can't be classified confidently (e.g. subject-specific requirements).
  educationRequired         String?
  minEducationLevel         EducationLevel?
  minMarksPercent           Float?
  categoryRelaxationApplies Boolean?
  // Age relaxation in years per category for THIS post specifically,
  // e.g. { "SC": 5, "OBC": 3 }. Kept per-post, not on Source, because a
  // notification can grant different relaxation to different post groups
  // (e.g. SSC CGL gives Group 'C' posts additional relaxation beyond the
  // general table) — one shared value would be wrong for some posts.
  categoryRelaxationRules   Json?
  eligibilityRules          Json?
  extractionCandidateId     String?
  candidatePostIndex        Int?
  extractionCandidate       ExtractionCandidate? @relation(fields: [extractionCandidateId], references: [id], onDelete: Restrict)
  reviewedDetails           Json?
  reviewedAt                DateTime?
  reviewNote                String?

  @@unique([extractionCandidateId, candidatePostIndex])
}

// Offline extraction drafts. Public browsing and matching read Post, not this table.
model ExtractionCandidate {
  id            String   @id @default(cuid())
  bundleId      String
  sourceUrl     String
  sourceName    String
  contentHash   String   @unique
  status        String   @default("needs_review")
  facts         Json
  review        Json
  evidenceUnits Json
  createdAt     DateTime @default(now())
  publishedPosts Post[]
  automationRecords AutomatedNoticeRecord[]

  @@index([bundleId, createdAt])
}

// Durable autonomous acceptance, retry/backoff, enrichment, and audit lineage records.
// Only accepted records publish or update rows in Post.
model AutomatedNoticeRecord {
  id                    String               @id @default(cuid())
  bundleId              String
  evidenceFingerprint   String
  extractionVersion     String
  decision              String
  publicationStatus     String
  persistenceAllowed    Boolean              @default(false)
  reasonCodes           Json
  retryCount            Int                  @default(0)
  backoffSeconds        Int                  @default(0)
  nextRetryAt           DateTime?
  noticeIdentity        Json
  readerSummary         Json?
  officialSyllabus      Json?
  historicalCutoffs     Json?
  visionRecovery        Json?
  enrichmentCandidates  Json?
  auditLineage          Json
  sourceId              String?
  source                Source?              @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  extractionCandidateId String?
  extractionCandidate   ExtractionCandidate? @relation(fields: [extractionCandidateId], references: [id], onDelete: SetNull)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@unique([bundleId, evidenceFingerprint])
  @@index([bundleId, updatedAt])
  @@index([decision, nextRetryAt])
}
